{
  "expo": {
    "name": "plated",
    "slug": "plated-v2",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "plated",
    "icon": "./assets/icon.png",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/7b2c1a05-5a75-4a60-80bf-a09d4e09d768"
    },
    "android": {
      "package": "com.fraseranalytics.plated",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_HEART_RATE_VARIABILITY",
        "android.permission.health.READ_RESTING_HEART_RATE",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_HEALTH_DATA_HISTORY"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1B1F24"
      }
    },
    "ios": {
      "bundleIdentifier": "com.fraseranalytics.plated"
    },
    "plugins": [
      "expo-dev-client",
      "expo-updates",
      [
        "expo-image-picker",
        {
          "photosPermission": "plated needs access to your photos so you can add a picture to a food you've created.",
          "cameraPermission": "plated uses your camera to scan barcodes and photograph foods you create."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "plated uses your camera to scan barcodes and photograph foods you create."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://de.sentry.io/",
          "organization": "fraser-analytics",
          "project": "plated",
          "experimental_android": { "enableAndroidGradlePlugin": true }
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "7b2c1a05-5a75-4a60-80bf-a09d4e09d768"
      }
    },
    "owner": "fraserr1188"
  }
}
